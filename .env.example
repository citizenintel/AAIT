# ─── Public / Client-safe ───────────────────────────────
VITE_APP_NAME="Alt Afrikaner | Incident Tracker"
VITE_BASE_PATH="/incident-tracker/"
VITE_SUPABASE_URL="<public-project-url>"
VITE_SUPABASE_ANON_KEY="<public-anon-key>"
VITE_MAX_UPLOAD_BYTES="1048576"
VITE_AI_ENABLED=""
VITE_MAP_PROVIDER="maplibre"
VITE_MAP_STYLE_URL="<approved-style-url>"
VITE_DEFAULT_LANGUAGE="en"
VITE_DEFAULT_COUNTRY="ZA"

# ─── Server-only (never in frontend) ───────────────────
SUPABASE_SERVICE_ROLE_KEY="<server-only>"
IDENTITY_ENCRYPTION_KEY_ID="<secret-manager-key-id>"
EVIDENCE_SIGNING_SECRET="<server-only>"
TURNSTILE_SECRET_KEY="<server-only>"
EMAIL_PROVIDER="disabled"
EMAIL_API_KEY="<server-only>"
# Address replies to reporters are sent from / reply to. Set to the real mailbox in your
# private .env (e.g. the project Outlook address). Never hard-code it in frontend source.
EMAIL_REPLY_TO="<contact-mailbox>"
# Max total size of citizen-report attachments (bytes). 1 MB keeps the repo/storage lean.
MAX_UPLOAD_BYTES="1048576"
PAYMENT_PROVIDER="disabled"
PAYMENT_PROVIDER_SECRET="<server-only>"
PAYMENT_WEBHOOK_SECRET="<server-only>"
# AI summariser for submissions (server-side only — never expose the key to the browser).
# Free-tier options that work well: "groq" (Llama 3.x, fast), "gemini" (Google free tier),
# "cloudflare" (Workers AI). The model condenses + strips PII into a public map draft and
# keeps sensitive data separate; it must never invent missing information (spec §2.12).
AI_PROVIDER="disabled"
AI_API_KEY="<server-only>"
# PayPal subscription payments. Client ID is safe for frontend; receiver email and webhook
# secret stay server-side. Sign up at developer.paypal.com. Use "sandbox" mode for testing.
VITE_PAYPAL_CLIENT_ID="<paypal-app-client-id>"
VITE_PAYPAL_MODE="sandbox"
PAYPAL_RECEIVER_EMAIL="<paypal-receiver-email>"
PAYPAL_WEBHOOK_SECRET="<server-only>"
SPONSORSHIP_PUBLIC_MODE="disabled"
MAX_ACTIVE_PUBLIC_SPONSORS="4"
